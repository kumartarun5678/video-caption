{
  "name": "video-caption-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:clean": "./kill-port.sh && sleep 1 && nodemon",
    "prebuild": "echo 'Starting TypeScript compilation...'",
    "build": "tsc && (test -f dist/backend/server.js && mv dist/backend/* dist/ && rm -rf dist/backend dist/shared || true) && (test -f dist/server.js && echo '✓ Build successful: dist/server.js exists' || (echo '✗ ERROR: dist/server.js not found after build!' && exit 1))",
    "postinstall": "echo 'Dependencies installed. Run yarn build to compile TypeScript.'",
    "build:clean": "rm -rf dist && yarn build",
    "start": "node dist/server.js",
    "start:build": "yarn build && node dist/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "kill-port": "./kill-port.sh"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^1.4.1",
    "@remotion/bundler": "4.0.68",
    "@remotion/renderer": "4.0.68",
    "assemblyai": "^4.19.0",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.3",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.4",
    "helmet": "^7.0.0",
    "mime-types": "^2.1.35",
    "multer": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.375",
    "uuid": "^9.0.0",
    "nodemon": "^3.0.1",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/fluent-ffmpeg": "^2.1.20",
    "@types/mime-types": "^2.1.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.5.5",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  }
}
